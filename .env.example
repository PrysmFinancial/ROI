# --- Docker setup (docker-compose.yml) ---
# DATABASE_URL is already set for you inside docker-compose.yml (points at the `db` service).
# Nothing to configure here if you're using `docker compose up` — this file is only relevant
# for the native (non-Docker) setup below.

# --- Native setup, macOS/Linux ---
# Local PostgreSQL uses your OS username via a unix socket (no password required).
# Databases: roi_development, roi_test
#
# Optional explicit connection URL:
# DATABASE_URL=postgres://localhost/roi_development

# --- Native setup, Windows ---
# Windows Postgres installs typically listen over TCP rather than a unix socket.
# Uncomment config/database.yml's `host`/`port` lines, or set an explicit URL here instead:
# DATABASE_URL=postgres://<username>:<password>@localhost:5432/roi_development
