<% content_for :title, "ROI — Who are you?" %>

<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<% end %>

<div class="min-h-screen flex flex-col items-center justify-center px-6 py-16">
  <header class="text-center mb-14">
    <h1 class="font-serif text-7xl md:text-8xl font-medium tracking-wide text-roi-text">ROI</h1>
    <p class="mt-4 text-[0.65rem] md:text-xs font-sans font-medium tracking-[0.35em] text-roi-muted uppercase">
      Restaurant Operational Intelligence
    </p>
    <p class="mt-10 font-serif text-3xl md:text-4xl text-roi-text">Who are you?</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 w-full max-w-3xl">
    <%= link_to host_path, class: "group block rounded-2xl border border-roi-border bg-roi-surface p-8 transition-colors hover:border-roi-muted/60 hover:bg-roi-surface/80" do %>
      <div class="mb-8 flex h-14 w-14 items-center justify-center rounded-full border border-roi-border text-roi-text">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
      </div>
      <p class="text-[0.65rem] font-sans font-medium tracking-[0.2em] text-roi-muted uppercase">
        Operational · iPad
      </p>
      <h2 class="mt-3 font-serif text-4xl text-roi-text">Host</h2>
      <p class="mt-4 font-sans text-sm leading-relaxed text-roi-muted">
        Run the floor — seating queue, pacing, the live plan.
      </p>
    <% end %>

    <%= link_to manager_path, class: "group block rounded-2xl border border-roi-border bg-roi-surface p-8 transition-colors hover:border-roi-muted/60 hover:bg-roi-surface/80" do %>
      <div class="mb-8 flex h-14 w-14 items-center justify-center rounded-full border border-roi-border text-roi-text">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.307a1.125 1.125 0 001.76 0L21.75 9M21.75 9v10.5" />
        </svg>
      </div>
      <p class="text-[0.65rem] font-sans font-medium tracking-[0.2em] text-roi-muted uppercase">
        Operational · Single Location
      </p>
      <h2 class="mt-3 font-serif text-4xl text-roi-text">Manager</h2>
      <p class="mt-4 font-sans text-sm leading-relaxed text-roi-muted">
        The night in numbers — covers, staffing, guests.
      </p>
    <% end %>
  </div>

  <p class="mt-14 max-w-md text-center font-sans text-xs leading-relaxed text-roi-muted">
    A persistent &ldquo;switch role&rdquo; control follows you across the app.
  </p>
</div>
