<% content_for :title, "ROI — Host · Pre-shift" %>

<div class="min-h-screen">
  <%= render "host_header", active_tab: "pre_shift" %>

  <main class="mx-auto max-w-6xl px-6 py-8 md:px-8 md:py-10">
    <div class="mb-8">
      <p class="text-[0.65rem] font-medium uppercase tracking-[0.22em] text-roi-muted">
        Friday 6 June · Before service
      </p>
      <h1 class="mt-2 font-serif text-4xl text-roi-text md:text-5xl">Tonight&rsquo;s pre-shift</h1>
    </div>

    <section class="mb-10 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4" aria-label="Pre-shift metrics">
      <% @metrics.each do |metric| %>
        <article class="rounded-2xl border border-roi-border bg-roi-surface px-5 py-5">
          <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-roi-muted">
            <%= metric[:label] %>
          </p>
          <p class="mt-3 font-serif text-4xl <%= metric[:accent] ? "text-roi-accent" : "text-roi-text" %>">
            <%= metric[:value] %>
          </p>
          <p class="mt-2 text-sm text-roi-muted"><%= metric[:detail] %></p>
        </article>
      <% end %>
    </section>

    <section class="mb-10" aria-labelledby="section-assignments-heading">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="section-assignments-heading" class="font-serif text-3xl text-roi-text">
            Section assignments
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-roi-muted">
            ROI proposes sections by forecast load and server baselines. Approve or adjust.
          </p>
        </div>
        <button type="button"
                class="inline-flex shrink-0 items-center justify-center rounded-xl bg-roi-btn px-5 py-3 text-sm font-medium text-roi-btn-text transition-opacity hover:opacity-90">
          Approve all
        </button>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <% @sections.each do |section| %>
          <article class="rounded-2xl border border-roi-border bg-roi-surface p-5">
            <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-roi-muted">
              <%= section[:zone] %>
            </p>
            <div class="mt-4 flex items-center gap-3">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-roi-border bg-roi-surface-raised font-serif text-lg text-roi-text">
                <%= section[:initial] %>
              </div>
              <div class="min-w-0">
                <p class="truncate text-lg text-roi-text"><%= section[:name] %></p>
                <p class="mt-0.5 text-sm text-roi-muted"><%= section[:detail] %></p>
              </div>
            </div>
            <button type="button"
                    class="mt-5 inline-flex items-center gap-2 text-[0.7rem] font-medium uppercase tracking-[0.16em] text-roi-muted transition-colors hover:text-roi-text">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 12h9.75m-9.75 6h9.75M3.75 6h.008v.008H3.75V6Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.008v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 6h.008v.008H3.75V18Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
              Adjust
            </button>
          </article>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="the-book-heading">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="the-book-heading" class="font-serif text-3xl text-roi-text">The book</h2>
        <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-roi-muted">
          <%= @reservations.size %> of 58 shown
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-roi-border bg-roi-surface">
        <ul class="divide-y divide-roi-border/80" role="list">
          <% @reservations.each do |reservation| %>
            <li class="grid grid-cols-[4.5rem_minmax(0,1fr)_auto] items-center gap-3 px-5 py-4 md:grid-cols-[5rem_8rem_minmax(0,1fr)_auto] md:gap-6">
              <time class="text-sm text-roi-muted"><%= reservation[:time] %></time>
              <p class="truncate font-medium text-roi-text"><%= reservation[:name] %></p>
              <p class="hidden truncate text-sm text-roi-muted md:block"><%= reservation[:note] %></p>
              <p class="text-right text-sm text-roi-muted">
                <span class="text-roi-text"><%= reservation[:covers] %></span>
                <span class="ml-1 hidden sm:inline">covers</span>
              </p>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  </main>
</div>
