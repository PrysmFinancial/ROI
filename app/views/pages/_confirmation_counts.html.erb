<div id="confirmation-counts" class="flex gap-7 text-right">
  <div>
    <p class="text-[0.6rem] font-medium uppercase tracking-[0.2em] text-roi-muted">Confirmed</p>
    <p class="mt-1 font-serif text-3xl text-roi-accent"><%= counts[:confirmed] %></p>
  </div>
  <div>
    <p class="text-[0.6rem] font-medium uppercase tracking-[0.2em] text-roi-muted">Pending</p>
    <p class="mt-1 font-serif text-3xl text-roi-accent"><%= counts[:pending] %></p>
  </div>
</div>
