<% content_for :title, "ROI — Manager" %>

<div class="min-h-screen">
  <%= render "manager_header", subtitle: "Single-location dashboard", show_rush: true %>

  <main class="mx-auto max-w-7xl space-y-8 px-6 py-6 md:px-8 md:py-8">
    <section class="grid grid-cols-2 gap-3 lg:grid-cols-6 lg:gap-4" aria-label="Tonight metrics">
      <% @kpis.each do |kpi| %>
        <article class="rounded-2xl border border-roi-border bg-roi-surface px-4 py-4 md:px-5">
          <p class="text-[0.6rem] font-medium uppercase tracking-[0.18em] text-roi-muted"><%= kpi[:label] %></p>
          <p class="mt-2 font-serif text-3xl text-roi-text md:text-4xl"><%= kpi[:value] %></p>
          <p class="mt-1 text-xs <%= kpi[:tone] == :up ? "text-roi-success" : kpi[:tone] == :down ? "text-roi-danger" : "text-roi-muted" %>">
            <%= kpi[:detail] %>
          </p>
        </article>
      <% end %>
    </section>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.9fr)] lg:gap-8">
      <div class="space-y-6">
        <section aria-labelledby="the-floor-heading">
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <h2 id="the-floor-heading" class="font-serif text-3xl text-roi-text">The floor</h2>
            <span class="text-[0.65rem] font-medium uppercase tracking-[0.16em] text-roi-muted">Open floor plan ›</span>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% @floor_status.each do |status| %>
              <article class="rounded-2xl border border-roi-border bg-roi-surface px-4 py-4">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full <%= table_status_dot(status[:tone]) %>" aria-hidden="true"></span>
                  <p class="text-[0.6rem] font-medium uppercase tracking-[0.16em] text-roi-muted"><%= status[:label] %></p>
                </div>
                <p class="mt-3 font-serif text-4xl text-roi-text"><%= status[:value] %></p>
              </article>
            <% end %>
          </div>
        </section>

        <section aria-labelledby="servers-on-heading">
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <h2 id="servers-on-heading" class="font-serif text-3xl text-roi-text">Servers on</h2>
            <p class="text-[0.65rem] font-medium uppercase tracking-[0.16em] text-roi-muted">Shift-start order</p>
          </div>
          <ul class="divide-y divide-roi-border/80 overflow-hidden rounded-2xl border border-roi-border bg-roi-surface" role="list">
            <% @servers_on.each do |server| %>
              <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-medium text-roi-text"><%= server[:name] %></p>
                    <% if server[:badge] %>
                      <span class="rounded-full border border-roi-danger/60 px-2 py-0.5 text-[0.55rem] font-medium uppercase tracking-[0.12em] text-roi-danger">
                        <%= server[:badge] %>
                      </span>
                    <% end %>
                  </div>
                  <p class="mt-1 text-sm text-roi-muted">
                    <%= server[:section] %> · <%= server[:covers] %> covers · <%= server[:pace] %>
                  </p>
                </div>
                <div class="text-right text-sm">
                  <p class="text-roi-text"><%= server[:cov_hr] %> <span class="text-roi-muted">cov / hr</span></p>
                  <p class="mt-0.5 <%= manager_vs_tone(server[:vs_tone]) %>"><%= server[:vs_base] %> vs base</p>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      </div>

      <div class="space-y-6">
        <section class="rounded-2xl border border-roi-border bg-roi-surface p-5" aria-labelledby="pacing-heading">
          <h2 id="pacing-heading" class="font-serif text-3xl text-roi-text">Pacing &amp; kitchen</h2>
          <div class="mt-5 space-y-4">
            <div>
              <div class="mb-1.5 flex justify-between text-sm">
                <span class="text-roi-muted">Kitchen load</span>
                <span class="text-roi-text"><%= @pacing[:kitchen_pct] %>%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-roi-surface-raised">
                <div class="h-full rounded-full bg-roi-warning" style="width: <%= @pacing[:kitchen_pct] %>%"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex justify-between text-sm">
                <span class="text-roi-muted">Floor pacing</span>
                <span class="text-roi-success"><%= @pacing[:floor_label] %></span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-roi-surface-raised">
                <div class="h-full rounded-full bg-roi-success" style="width: <%= @pacing[:floor_pct] %>%"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex justify-between text-sm">
                <span class="text-roi-muted">Predicted late demand</span>
                <span class="text-roi-muted"><%= @pacing[:late_demand] %></span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-roi-surface-raised">
                <div class="h-full rounded-full bg-roi-info" style="width: <%= @pacing[:late_pct] %>%"></div>
              </div>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-3 rounded-xl border border-roi-border bg-roi-bg/50 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-roi-text">
              Cut recommended — <span class="font-medium"><%= @pacing[:cut_name] %></span> at <%= @pacing[:cut_time] %>.
            </p>
            <%= link_to "Review", manager_staffing_path,
                  class: "inline-flex shrink-0 items-center justify-center rounded-xl bg-roi-btn px-4 py-2 text-sm font-medium text-roi-btn-text transition-opacity hover:opacity-90" %>
          </div>
        </section>

        <section aria-labelledby="tonight-heading">
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <h2 id="tonight-heading" class="font-serif text-3xl text-roi-text">Tonight</h2>
            <span class="text-[0.65rem] font-medium uppercase tracking-[0.16em] text-roi-muted">On the pass</span>
          </div>
          <ul class="space-y-3 rounded-2xl border border-roi-border bg-roi-surface px-5 py-4" role="list">
            <% @tonight_feed.each do |event| %>
              <li class="flex gap-3 text-sm">
                <time class="shrink-0 text-roi-muted"><%= event[:time] %></time>
                <span class="text-roi-text"><%= event[:text] %></span>
              </li>
            <% end %>
          </ul>
        </section>
      </div>
    </div>

    <section aria-labelledby="manager-tools-heading">
      <h2 id="manager-tools-heading" class="mb-4 font-serif text-3xl text-roi-text">Manager tools</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% @tools.each do |tool| %>
          <%= link_to send(tool[:path_helper]),
                class: "group block rounded-2xl border border-roi-border bg-roi-surface p-5 transition-colors hover:border-roi-muted/60" do %>
            <p class="font-serif text-2xl text-roi-text"><%= tool[:title] %></p>
            <p class="mt-2 text-sm leading-relaxed text-roi-muted"><%= tool[:detail] %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  </main>
</div>
